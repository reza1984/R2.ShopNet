{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "Consul": {
    "Address": "http://localhost:8500",
    "HealthCheckUrl": "https://host.docker.internal:5000/health",
    "ServiceMappings": [
      {
        "RouteId": "identity-api-route",
        "ClusterId": "identity-cluster",
        "ServiceName": "identity-service",
        "PathPattern": "/api/identity/{**catch-all}",
        "ServicePort": 5003,
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      {
        "RouteId": "identity-connect-route",
        "ClusterId": "identity-cluster",
        "ServiceName": "identity-service",
        "PathPattern": "/connect/{**catch-all}",
        "ServicePort": 5003,
        "Transforms": []
      },
      {
        "RouteId": "identity-wellknown-route",
        "ClusterId": "identity-cluster",
        "ServiceName": "identity-service",
        "PathPattern": "/.well-known/{**catch-all}",
        "ServicePort": 5003,
        "Transforms": []
      },
      {
        "RouteId": "catalog-api-route",
        "ClusterId": "catalog-cluster",
        "ServiceName": "catalog-service",
        "PathPattern": "/api/catalog/{**catch-all}",
        "ServicePort": 5004,
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      }
    ]
  },
  "Gateway": {
    "ServiceName": "gateway",
    "HealthCheckPath": "/health",
    "ReadyCheckPath": "/ready"
  },
  "Authentication": {
    "Authority": "https://localhost:5003",
    "Audience": "shopnet-api",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:64425",
      "https://admin.shopnet.local"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:01:00"
  }
}
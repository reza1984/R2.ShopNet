@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<!-- Backdrop to close dropdown when clicking outside -->
@if (IsOpen)
{
    <div class="fixed inset-0 z-30" @onclick="CloseDropdown"></div>
}

<!-- User Dropdown -->
<div class="relative">
    <button @onclick="ToggleDropdown"
            class="flex items-center text-gray-700 dark:text-gray-400">
        <span class="mr-3 flex items-center justify-center overflow-hidden rounded-full h-11 w-11 bg-brand-100 dark:bg-brand-900/20">
            <Icon Name="person" Size="24" Color="currentColor" />
        </span>
        <span class="block mr-1 font-medium text-theme-sm">@UserName</span>
        <span class="@GetDropdownArrowClasses()">
            <Icon Name="expand_more" Size="20" />
        </span>
    </button>

    @if (IsOpen)
    {
        <div class="absolute right-0 mt-[17px] flex w-[260px] flex-col rounded-2xl border border-gray-200 bg-white p-3 shadow-theme-lg dark:border-gray-800 dark:bg-gray-dark z-40">
            <div>
                <span class="block font-medium text-gray-700 text-theme-sm dark:text-gray-400">
                    @UserName
                </span>
                <span class="mt-0.5 block text-theme-xs text-gray-500 dark:text-gray-400">
                    @UserEmail
                </span>
            </div>

            <ul class="flex flex-col gap-1 pt-4 pb-3 border-b border-gray-200 dark:border-gray-800">
                <li>
                    <a href="/settings/profile"
                       @onclick="CloseDropdown"
                       class="flex items-center gap-3 px-3 py-2 font-medium text-gray-700 rounded-lg group text-theme-sm hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-gray-300">
                        <Icon Name="person" Size="24" Color="currentColor" />
                        Edit profile
                    </a>
                </li>
                <li>
                    <a href="/settings/security"
                       @onclick="CloseDropdown"
                       class="flex items-center gap-3 px-3 py-2 font-medium text-gray-700 rounded-lg group text-theme-sm hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-gray-300">
                        <Icon Name="lock" Size="24" Color="currentColor" />
                        Account Security
                    </a>
                </li>
                <li>
                    <a href="/settings"
                       @onclick="CloseDropdown"
                       class="flex items-center gap-3 px-3 py-2 font-medium text-gray-700 rounded-lg group text-theme-sm hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-gray-300">
                        <Icon Name="settings" Size="24" Color="currentColor" />
                        Account Settings
                    </a>
                </li>
                <li>
                    <a href="/settings/support"
                       @onclick="CloseDropdown"
                       class="flex items-center gap-3 px-3 py-2 font-medium text-gray-700 rounded-lg group text-theme-sm hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-gray-300">
                        <Icon Name="info" Size="24" Color="currentColor" />
                        Support
                    </a>
                </li>
            </ul>
            <button @onclick="HandleLogout"
                    class="flex items-center gap-3 px-3 py-2 mt-3 font-medium text-gray-700 rounded-lg group text-theme-sm hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-gray-300">
                <Icon Name="logout" Size="24" Color="currentColor" />
                Sign out
            </button>
        </div>
    }
</div>

@code {
    private bool IsOpen { get; set; }
    private string UserName { get; set; } = "Guest";
    private string UserEmail { get; set; } = "";
    private ClaimsPrincipal? User { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfo();
    }

    private async Task LoadUserInfo()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        User = authState.User;

        if (User?.Identity?.IsAuthenticated == true)
        {
            // Get name from claims (try multiple claim types)
            UserName = User.FindFirst("name")?.Value
                       ?? User.FindFirst(ClaimTypes.Name)?.Value
                       ?? User.FindFirst("preferred_username")?.Value
                       ?? User.Identity.Name
                       ?? "User";

            // Get email from claims
            UserEmail = User.FindFirst("email")?.Value
                        ?? User.FindFirst(ClaimTypes.Email)?.Value
                        ?? "";
        }
    }

    private void ToggleDropdown()
    {
        IsOpen = !IsOpen;
    }

    private void CloseDropdown()
    {
        IsOpen = false;
    }

    private async Task HandleLogout()
    {
        IsOpen = false;
        NavigationManager.NavigateTo("/logout", forceLoad: true);
    }

    private string GetDropdownArrowClasses()
    {
        var baseClasses = "transition-transform duration-200";
        return IsOpen ? $"{baseClasses} rotate-180" : baseClasses;
    }
}

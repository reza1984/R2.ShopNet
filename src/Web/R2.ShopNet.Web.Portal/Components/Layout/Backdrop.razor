@using R2.ShopNet.Web.Portal.Services
@inject ISidebarService SidebarService
@implements IDisposable

@if (SidebarService.IsMobileOpen)
{
    <div class="fixed inset-0 z-40 bg-gray-900/50 lg:hidden"
         @onclick="CloseSidebar"></div>
}

@code {
    protected override void OnInitialized()
    {
        SidebarService.OnChange += StateHasChanged;
    }

    private void CloseSidebar()
    {
        SidebarService.SetMobileOpen(false);
    }

    public void Dispose()
    {
        SidebarService.OnChange -= StateHasChanged;
    }
}

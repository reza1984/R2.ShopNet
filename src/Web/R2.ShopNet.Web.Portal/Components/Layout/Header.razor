@using R2.ShopNet.Web.Portal.Services
@using R2.ShopNet.Web.Portal.Services.JsInterop
@inject ISidebarService SidebarService
@inject IThemeService ThemeService
@inject IThemeJsInterop ThemeJsInterop
@inject IWindowJsInterop WindowJsInterop
@implements IDisposable

<header class="sticky top-0 flex w-full bg-white border-gray-200 z-99999 dark:border-gray-800 dark:bg-gray-900 xl:border-b">
    <div class="flex flex-col items-center justify-between grow xl:flex-row xl:px-6">
        <div class="flex items-center justify-between w-full gap-2 px-3 py-3 border-b border-gray-200 dark:border-gray-800 sm:gap-4 xl:justify-normal xl:border-b-0 xl:px-0 lg:py-4">
            <button class="@GetMenuButtonClasses()"
                    @onclick="() => HandleToggle()"
                    aria-label="Toggle Sidebar">
                @if (SidebarService.IsMobileOpen)
                {
                    <Icon Name="close" Size="24" />
                }
                else
                {
                    <Icon Name="menu" Size="24" />
                }
            </button>

            <!-- Logo for mobile -->
            <a href="/dashboard" class="xl:hidden">
                <div class="flex items-center gap-2">
                    <span class="text-2xl font-bold text-brand-600 dark:text-brand-400">R2</span>
                    <span class="text-xl font-semibold text-gray-800 dark:text-gray-200">ShopNet</span>
                </div>
            </a>

            <button @onclick="ToggleApplicationMenu"
                    class="flex items-center justify-center w-10 h-10 text-gray-700 rounded-lg z-99999 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 xl:hidden">
                <Icon Name="more_horiz" Size="24" />
            </button>

            <div class="hidden xl:block">
                <form>
                    <div class="relative">
                        <span class="absolute -translate-y-1/2 pointer-events-none left-4 top-1/2 text-gray-500 dark:text-gray-400">
                            <Icon Name="search" Size="20" />
                        </span>
                        <input type="text"
                               placeholder="Search or type command..."
                               class="h-11 w-full rounded-lg border border-gray-200 bg-transparent py-2.5 pl-12 pr-14 text-sm text-gray-800 shadow-theme-xs placeholder:text-gray-400 focus:border-brand-300 focus:outline-hidden focus:ring-3 focus:ring-brand-500/10 dark:border-gray-800 dark:bg-white/3 dark:text-white/90 dark:placeholder:text-white/30 dark:focus:border-brand-800 xl:w-[430px]" />
                        <button class="absolute right-2.5 top-1/2 inline-flex -translate-y-1/2 items-center gap-0.5 rounded-lg border border-gray-200 bg-gray-50 px-[7px] py-[4.5px] text-xs -tracking-[0.2px] text-gray-500 dark:border-gray-800 dark:bg-white/3 dark:text-gray-400">
                            <span>⌘</span>
                            <span>K</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="@GetApplicationMenuClasses()">
            <div class="flex items-center gap-2 2xsm:gap-3">
                <!-- Theme Toggle Button -->
                <button @onclick="ToggleTheme"
                        class="flex items-center justify-center w-10 h-10 text-gray-700 rounded-lg hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 lg:h-11 lg:w-11"
                        aria-label="Toggle Theme">
                    @if (ThemeService.CurrentTheme == ThemeMode.Light)
                    {
                        <Icon Name="dark_mode" Size="20" />
                    }
                    else
                    {
                        <Icon Name="light_mode" Size="20" />
                    }
                </button>

                <!-- User Dropdown -->
                <UserDropdown />
            </div>
        </div>
    </div>
</header>

@code {
    private bool IsApplicationMenuOpen { get; set; }

    protected override void OnInitialized()
    {
        SidebarService.OnChange += StateHasChanged;
        ThemeService.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeTheme();
        }
    }

    private async Task InitializeTheme()
    {
        try
        {
            // Detect system preference first (always)
            var systemPrefersDark = await ThemeJsInterop.GetSystemPrefersDarkModeAsync();
            ThemeService.SystemPreference = systemPrefersDark ? ThemeMode.Dark : ThemeMode.Light;

            // Check if user has a saved preference
            var savedTheme = await ThemeJsInterop.GetSavedThemeAsync();

            if (!string.IsNullOrEmpty(savedTheme))
            {
                // Use saved preference (manual override)
                ThemeService.SetTheme(savedTheme == "dark" ? ThemeMode.Dark : ThemeMode.Light);
                await ApplyTheme();
            }
            else
            {
                // Use system preference
                ThemeService.SetTheme(systemPrefersDark ? ThemeMode.Dark : ThemeMode.Light);
                await ApplyTheme();

                // Listen for system theme changes (only auto-switch if no manual preference)
                await ThemeJsInterop.ListenForSystemThemeChangesAsync();
            }
        }
        catch
        {
            // Fallback to light theme if JS fails
            ThemeService.SetTheme(ThemeMode.Light);
        }
    }

    /// <summary>
    /// Resets theme to system preference and clears manual override
    /// </summary>
    private async Task ResetToSystemPreference()
    {
        await ThemeJsInterop.RemoveThemeAsync();
        ThemeService.ResetToSystemPreference();
        await ApplyTheme();
    }

    private async Task HandleToggle()
    {
        var windowWidth = await WindowJsInterop.GetWindowWidthAsync();

        if (windowWidth >= 1280)
        {
            // Desktop: toggle expanded state
            SidebarService.ToggleExpanded();
        }
        else
        {
            // Mobile: toggle mobile open state
            SidebarService.ToggleMobileOpen();
        }
    }

    private void ToggleApplicationMenu()
    {
        IsApplicationMenuOpen = !IsApplicationMenuOpen;
    }

    private async Task ToggleTheme()
    {
        ThemeService.ToggleTheme();
        await ApplyTheme();
    }

    private async Task ApplyTheme()
    {
        var themeString = ThemeService.GetThemeString();
        await ThemeJsInterop.SaveThemeAsync(themeString);

        if (ThemeService.CurrentTheme == ThemeMode.Dark)
        {
            await ThemeJsInterop.ApplyDarkModeAsync();
        }
        else
        {
            await ThemeJsInterop.RemoveDarkModeAsync();
        }
    }

    private string GetMenuButtonClasses()
    {
        var classes = new List<string>
        {
            "items-center", "justify-center", "w-10", "h-10", "text-gray-500",
            "border-gray-200", "rounded-lg", "z-99999", "dark:border-gray-800",
            "flex", "dark:text-gray-400", "lg:h-11", "lg:w-11", "xl:border"
        };

        if (SidebarService.IsMobileOpen)
        {
            classes.Add("bg-gray-100");
            classes.Add("dark:bg-white/[0.03]");
        }

        return string.Join(" ", classes);
    }

    private string GetApplicationMenuClasses()
    {
        var classes = new List<string>
        {
            "items-center", "justify-between", "w-full", "gap-4", "px-5", "py-4",
            "xl:flex", "shadow-theme-md", "xl:justify-end", "xl:px-0", "xl:shadow-none"
        };

        if (IsApplicationMenuOpen)
            classes.Add("flex");
        else
            classes.Add("hidden");

        return string.Join(" ", classes);
    }

    public void Dispose()
    {
        SidebarService.OnChange -= StateHasChanged;
        ThemeService.OnChange -= StateHasChanged;
    }
}

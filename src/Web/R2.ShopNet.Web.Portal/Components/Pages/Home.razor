@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Home - R2.ShopNet Portal</PageTitle>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-title-lg font-semibold text-gray-900 dark:text-white">Dashboard</h1>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="bg-gradient-to-br from-brand-500 to-brand-700 text-white p-8 rounded-xl shadow-theme-lg mb-6">
                <p class="text-2xl mb-2">Hello, <strong>@context.User.Identity?.Name</strong>!</p>
                <p class="text-brand-100">You are successfully authenticated via OpenID Connect with passkey support.</p>
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 mb-6">
                <div class="bg-white dark:bg-gray-900 p-6 rounded-xl shadow-theme-sm border border-gray-200 dark:border-gray-800">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-brand-100 dark:bg-brand-900">
                            <span class="material-symbols-rounded text-brand-600 dark:text-brand-400">person</span>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Total Users</p>
                            <p class="text-2xl font-semibold text-gray-900 dark:text-white">1,234</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white dark:bg-gray-900 p-6 rounded-xl shadow-theme-sm border border-gray-200 dark:border-gray-800">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-success-100 dark:bg-success-900">
                            <span class="material-symbols-rounded text-success-600 dark:text-success-400">shopping_bag</span>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Total Orders</p>
                            <p class="text-2xl font-semibold text-gray-900 dark:text-white">5,678</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white dark:bg-gray-900 p-6 rounded-xl shadow-theme-sm border border-gray-200 dark:border-gray-800">
                    <div class="flex items-center gap-4">
                        <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-orange-100 dark:bg-orange-900">
                            <span class="material-symbols-rounded text-orange-600 dark:text-orange-400">category</span>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Total Products</p>
                            <p class="text-2xl font-semibold text-gray-900 dark:text-white">890</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-900 p-6 rounded-xl shadow-theme-sm border border-gray-200 dark:border-gray-800">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Render Mode: Interactive Server (SSR + SignalR)</h2>
                <p class="text-gray-600 dark:text-gray-400 mb-4">This page uses the Interactive Server render mode, which provides:</p>
                <ul class="space-y-2 mb-6">
                    <li class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
                        <span class="text-success-600 dark:text-success-400">✓</span>
                        <span>Pre-rendered on server (fast initial load)</span>
                    </li>
                    <li class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
                        <span class="text-success-600 dark:text-success-400">✓</span>
                        <span>Interactive via SignalR (immediate interactivity)</span>
                    </li>
                    <li class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
                        <span class="text-success-600 dark:text-success-400">✓</span>
                        <span>Server-side processing (secure authentication state)</span>
                    </li>
                </ul>

                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Your Claims:</h3>
                <div class="max-h-96 overflow-y-auto border border-gray-200 dark:border-gray-800 rounded-lg">
                    <table class="w-full">
                        <thead class="sticky top-0 bg-gray-50 dark:bg-gray-800 z-1">
                            <tr>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Type</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Value</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
                            @foreach (var claim in context.User.Claims)
                            {
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
                                    <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-white">@claim.Type</td>
                                    <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 break-all">@claim.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="bg-white dark:bg-gray-900 p-6 rounded-xl shadow-theme-sm border border-gray-200 dark:border-gray-800">
                <p class="text-gray-700 dark:text-gray-300">You are not authenticated. Please <a href="/login" class="text-brand-600 dark:text-brand-400 hover:underline">login</a>.</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

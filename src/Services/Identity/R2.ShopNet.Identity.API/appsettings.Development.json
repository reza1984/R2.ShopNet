{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "R2.ShopNet.Framework.Configuration": "Debug"
    }
  },
  "Consul": {
    "KeyValue": {
      "MaxConcurrentConnections": 3,
      "MaxRetries": 5,
      "BaseDelaySeconds": 3,
      "MaxDelaySeconds": 60
    }
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromEmail": "noreply@shopnet.com",
    "FromName": "ShopNet",
    "ClientBaseUrl": "http://localhost:4200"
  }
}

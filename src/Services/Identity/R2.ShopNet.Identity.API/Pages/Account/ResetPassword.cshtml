@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div>
    <div class="mb-5 sm:mb-8">
        <h1 class="mb-2 font-semibold text-gray-800 dark:text-white/90 text-title-sm sm:text-title-md">
            Reset Password
        </h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">
            Enter your new password below.
        </p>
    </div>

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div
            class="p-4 mb-6 text-sm text-red-800 bg-red-100 border border-red-200 rounded-lg dark:bg-red-900/20 dark:border-red-900/50 dark:text-red-400">
            @Model.ErrorMessage
        </div>
    }

    <!-- Success Message -->
    @if (Model.IsSuccess)
    {
        <div
            class="p-4 mb-6 text-sm text-green-800 bg-green-100 border border-green-200 rounded-lg dark:bg-green-900/20 dark:border-green-900/50 dark:text-green-400">
            Your password has been reset successfully!
        </div>
    }

    <div asp-validation-summary="ModelOnly"
        class="p-4 mb-6 text-sm text-red-800 bg-red-100 border border-red-200 rounded-lg dark:bg-red-900/20 dark:border-red-900/50 dark:text-red-400">
    </div>

    <!-- Form -->
    @if (!Model.IsSuccess)
    {
        <form method="post">
            <input type="hidden" asp-for="Input.Email" />
            <input type="hidden" asp-for="Input.Token" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <div class="space-y-6">
                <div>
                    <label asp-for="Input.Password" class="block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                        New Password <span class="text-error-500">*</span>
                    </label>
                    <div class="relative">
                        <input asp-for="Input.Password" type="password" id="password-input" placeholder="Enter new password"
                            autocomplete="new-password"
                            class="w-full px-4 py-3 text-sm text-gray-800 border-2 border-gray-200 rounded-xl focus:border-primary focus:outline-none transition-colors duration-200 pr-12 dark:bg-white/5 dark:border-gray-800 dark:text-white/90 dark:placeholder:text-gray-500" />
                        <button type="button" onclick="togglePassword('password-input', 'eye-off-1', 'eye-on-1')"
                            class="absolute z-30 -translate-y-1/2 cursor-pointer right-4 top-1/2 text-gray-500 dark:text-gray-400">
                            <svg id="eye-off-1" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                            </svg>
                            <svg id="eye-on-1" class="w-5 h-5" style="display: none;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="block mt-1 text-sm text-error-600 dark:text-error-400"></span>
                </div>

                <div>
                    <label asp-for="Input.ConfirmPassword" class="block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                        Confirm Password <span class="text-error-500">*</span>
                    </label>
                    <div class="relative">
                        <input asp-for="Input.ConfirmPassword" type="password" id="confirm-password-input" placeholder="Confirm new password"
                            autocomplete="new-password"
                            class="w-full px-4 py-3 text-sm text-gray-800 border-2 border-gray-200 rounded-xl focus:border-primary focus:outline-none transition-colors duration-200 pr-12 dark:bg-white/5 dark:border-gray-800 dark:text-white/90 dark:placeholder:text-gray-500" />
                        <button type="button" onclick="togglePassword('confirm-password-input', 'eye-off-2', 'eye-on-2')"
                            class="absolute z-30 -translate-y-1/2 cursor-pointer right-4 top-1/2 text-gray-500 dark:text-gray-400">
                            <svg id="eye-off-2" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                            </svg>
                            <svg id="eye-on-2" class="w-5 h-5" style="display: none;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="block mt-1 text-sm text-error-600 dark:text-error-400"></span>
                </div>

                <button type="submit"
                    class="w-full py-3 px-6 text-sm font-medium text-white bg-brand-500 hover:bg-brand-600 rounded-xl transition-all duration-200">
                    Reset Password
                </button>
            </div>
        </form>
    }
    else
    {
        <div class="text-center">
            <a asp-page="./Login"
                class="inline-block w-full py-3 px-6 text-sm font-medium text-white bg-brand-500 hover:bg-brand-600 rounded-xl transition-all duration-200">
                Go to Sign In
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function togglePassword(inputId, eyeOffId, eyeOnId) {
            const input = document.getElementById(inputId);
            const eyeOff = document.getElementById(eyeOffId);
            const eyeOn = document.getElementById(eyeOnId);

            if (input.type === 'password') {
                input.type = 'text';
                eyeOff.style.display = 'none';
                eyeOn.style.display = 'block';
            } else {
                input.type = 'password';
                eyeOff.style.display = 'block';
                eyeOn.style.display = 'none';
            }
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}

@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div>
    <div class="mb-5 sm:mb-8">
        <h1 class="mb-2 font-semibold text-gray-800 dark:text-white/90 text-title-sm sm:text-title-md">
            Forgot Password
        </h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">
            Enter your email address and we'll send you a link to reset your password.
        </p>
    </div>

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div
            class="p-4 mb-6 text-sm text-red-800 bg-red-100 border border-red-200 rounded-lg dark:bg-red-900/20 dark:border-red-900/50 dark:text-red-400">
            @Model.ErrorMessage
        </div>
    }

    <div asp-validation-summary="ModelOnly"
        class="p-4 mb-6 text-sm text-red-800 bg-red-100 border border-red-200 rounded-lg dark:bg-red-900/20 dark:border-red-900/50 dark:text-red-400">
    </div>

    <!-- Form -->
    <form method="post">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div class="space-y-6">
            <div>
                <label asp-for="Input.Email" class="block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                    Email <span class="text-error-500">*</span>
                </label>
                <input asp-for="Input.Email" type="email" placeholder="info@gmail.com" autocomplete="email"
                    class="w-full px-4 py-3 text-sm text-gray-800 border-2 border-gray-200 rounded-xl focus:border-primary focus:outline-none transition-colors duration-200 dark:bg-white/5 dark:border-gray-800 dark:text-white/90 dark:placeholder:text-gray-500" />
                <span asp-validation-for="Input.Email" class="block mt-1 text-sm text-error-600 dark:text-error-400"></span>
            </div>

            <button type="submit"
                class="w-full py-3 px-6 text-sm font-medium text-white bg-brand-500 hover:bg-brand-600 rounded-xl transition-all duration-200">
                Send Reset Link
            </button>

            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl"
                class="inline-flex items-center justify-center gap-2 text-sm text-brand-500 hover:text-brand-600 dark:text-brand-400 dark:hover:text-brand-300 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Back to Sign In
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

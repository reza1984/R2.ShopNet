@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Forgot Password Confirmation";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div>
    <div class="mb-5 sm:mb-8">
        <h1 class="mb-2 font-semibold text-gray-800 dark:text-white/90 text-title-sm sm:text-title-md">
            Check Your Email
        </h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">
            We've sent you a password reset link.
        </p>
    </div>

    <div class="space-y-6">
        <div class="p-6 bg-gray-50 dark:bg-white/5 rounded-xl">
            <p class="mb-4 text-sm text-gray-700 dark:text-gray-300">
                If an account exists with the email you provided, you will receive a password reset link shortly.
            </p>
            <p class="mb-4 text-sm text-gray-700 dark:text-gray-300">
                Please check your inbox and follow the instructions in the email to reset your password.
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400">
                <strong>Note:</strong> The reset link will expire in 1 hour.
            </p>
        </div>

        <div class="text-sm text-center text-gray-600 dark:text-gray-400">
            Didn't receive the email? Check your spam folder.
        </div>

        <a asp-page="./ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl"
            class="block w-full py-3 px-6 text-sm font-medium text-center text-white bg-brand-500 hover:bg-brand-600 rounded-xl transition-all duration-200">
            Request Another Link
        </a>

        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl"
            class="inline-flex items-center justify-center gap-2 text-sm text-brand-500 hover:text-brand-600 dark:text-brand-400 dark:hover:text-brand-300 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Sign In
        </a>
    </div>
</div>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Consul": {
    "Address": "http://localhost:8500",
    "ServiceName": "catalog-service",
    "ServiceId": "catalog-service-1",
    "ServiceAddress": "localhost",
    "ServicePort": 5004,
    "HealthCheckUrl": "http://host.docker.internal:5004/health",
    "KeyValue": {
      "Address": "http://localhost:8500",
      "KeyPrefix": "shopnet/catalog-service/",
      "MaxConcurrentConnections": 5,
      "MaxRetries": 10,
      "BaseDelaySeconds": 5,
      "MaxDelaySeconds": 300
    }
  },
  "Redis": {
    "KeyValue": {
      "ConnectionString": "localhost:6379"
    }
  }
}
